# Public site URL (used for sitemap, robots, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.politrip.com.tr

# Convex deployment URL (safe to expose — queries are public, mutations are admin-gated)
NEXT_PUBLIC_CONVEX_URL=https://YOUR_DEPLOYMENT.convex.cloud

# Owner bootstrap password (server-only — never prefix with NEXT_PUBLIC_)
# Used to create/sign in the first OWNER account together with ADMIN_EMAIL.
DASHBOARD_PASSWORD=change-me-to-a-long-random-password

# Owner email. Required to bootstrap the owner account. Customer sign-up cannot use this role.
# Use a private operator email — not the public info@ address.
ADMIN_EMAIL=operator@politrip.com.tr

# HMAC signing secret for sessions + Convex identity tokens.
# If omitted, DASHBOARD_PASSWORD is used. Set the SAME value in Convex:
#   npx convex env set ADMIN_SECRET "<this-value>"
ADMIN_SECRET=change-me-to-a-long-random-secret

# Optional. When true (or in development), /api/auth/forgot-password may return a reset URL.
# PASSWORD_RESET_DEV_RETURN=true

# Optional. Resend transactional email for password resets.
# Without these, reset still works in development via the returned URL, and
# production users can recover via WhatsApp / info@politrip.com.tr.
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM="PoliTrip <noreply@politrip.com.tr>"
